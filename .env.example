# --- API server (server/index.ts) ---
# Port for `npm start` / `npm run dev:api`
PORT=8787
# Use a different dataset file (same JSON format as server/data/scholarships.json)
# DATA_FILE=/path/to/scholarships.json
# Comma-separated origins allowed to call the API cross-origin (only needed if the
# web app is hosted on a different domain than the API)
# CORS_ORIGIN=https://levelup.example.com

# --- Web app (Vite) ---
# Where the web app sends API requests. Defaults to same-origin /api.
# VITE_API_URL=https://api.levelup.example.com/api
