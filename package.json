{
  "name": "levelup-scholarships",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c magenta,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:api": "tsx watch server/index.ts",
    "build": "tsc -b && vite build",
    "start": "tsx server/index.ts",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "data:report": "tsx server/report.ts"
  },
  "dependencies": {
    "express": "4.22.3",
    "lucide-react": "0.460.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.6",
    "tsx": "4.23.15"
  },
  "devDependencies": {
    "@types/express": "4.17.21",
    "@types/node": "22.10.1",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "concurrently": "9.1.0",
    "postcss": "8.5.28",
    "tailwindcss": "3.4.19",
    "typescript": "5.6.3",
    "vite": "6.4.3"
  }
}
