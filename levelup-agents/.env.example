# Optional: AI-written agent plans (otherwise guided mode, free)
ANTHROPIC_API_KEY=
LEVELUP_MODEL=claude-opus-5-5
# Accounts (otherwise guest mode)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Payments (Stripe). Server-only except NEXT_PUBLIC_PAYMENTS.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO=
NEXT_PUBLIC_PAYMENTS=on
NEXT_PUBLIC_SITE_URL=https://levelup-ai-team.vercel.app

# In-app purchases (RevenueCat). The two NEXT_PUBLIC keys are public SDK keys; the webhook secret is private.
NEXT_PUBLIC_REVENUECAT_IOS_KEY=
NEXT_PUBLIC_REVENUECAT_ANDROID_KEY=
REVENUECAT_WEBHOOK_SECRET=

# Deep links: email links open the app
APPLE_TEAM_ID=
ANDROID_CERT_SHA256=

# Shown on the Privacy and Delete-account pages
NEXT_PUBLIC_CONTACT_EMAIL=
